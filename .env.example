# supernova 环境配置(模板)
# 复制为 .env;引擎/账号配置放 .env.profiles/<profile>.env(见 .env.profiles.example/)。

# 当前引擎/账号: 改这一行切换,对应 .env.profiles/<name>.env
SUPERNOVA_PROFILE=glm-anthropic

SUPERNOVA_BROWSER_ENGINE=agent-browser         # agent-browser(默认) | playwright
# git URL 扫描模式凭据(仅 https user:token;本地路径模式无需)
GITLAB_USER=
GITLAB_TOKEN=
# 并发上限:白盒 vuln agents + 黑盒 exploit agents
SUPERNOVA_MAX_CONCURRENT=2
# LLM 轨开关: =0 只关 inj/xss/ssrf 的 vuln agent(GitNexus 兜底);=1 双轨 OR
SUPERNOVA_LLM_TRACK_ENABLED=0
# GitNexus 轨 LLM(sink/taint/chain_verdict 轻量判定);关轨时靠它兜底召回
SUPERNOVA_GITNEXUS_LLM_ENABLED=1
# GitNexus 轨单次 LLM 调用超时秒数(默认 60;大仓推荐 360)
SUPERNOVA_LLM_PER_CALL_TIMEOUT=360
# 报告前全卡接口表富化 agent 的 turn 预算(默认 100)。per-class 单 agent
# 富化该类全部卡——卡多(如 auth 11 张)逐卡钉行号链时 30 不够,耗尽即整类
# 0 富化(非致命,确定性 endpoint 兜底)。大仓/卡多可再调大。
SUPERNOVA_ENDPOINT_ENRICH_MAX_TURNS=100
# GN-only 卡富化 agent(含 report-polish rework)的 turn 预算(默认 100,原 30,
# 2026-08-28 与上条同批调大——同任务形态同理)
SUPERNOVA_GN_ENRICH_MAX_TURNS=100
# verdict 多轮深判 turn 预算(默认 30;2026-09-01 起支持工作区 env 覆盖,此处为
# 全局回落)。CHAIN 管 inj/xss/ssrf 判定主链;GITNEXUS 是 authz 深判等不传参
# 调用方的回落默认。调大单链耗时上升,需与 CHAIN_VERDICT_CONCURRENCY 按
# 容量铁律(链数÷并发×单链耗时≤窗口)配平。
# SUPERNOVA_CHAIN_VERDICT_MAX_TURNS=30
# SUPERNOVA_GITNEXUS_VERDICT_MAX_TURNS=30
# attempt 级重试不进终端 UI(真失败仍可见)
SUPERNOVA_SILENT_RETRY=1
# 扫描范围:逗号分隔 vuln 类(如 injection,xss);默认全类
# SUPERNOVA_VULN_CLASSES=
# 单次扫描预算(获槽起算,默认 5h);大仓建议调大。排队不限时(continue-as-new
# 防历史膨胀),预算只约束获槽后的扫描段
# SUPERNOVA_SCAN_BUDGET_HOURS=5

# Web 认证
SUPERNOVA_WEB_SESSION_TTL_HOURS=12
# 默认按请求 scheme 自动判 secure;=1 无条件强制(仅生产 HTTPS 反代需要,http 下会登录循环)
# SUPERNOVA_WEB_COOKIE_SECURE=1
# users.yaml 未创建时走默认 admin(admin/123456 首登改密);自定义见 configs/users.yaml.example
SUPERNOVA_WEB_USERS_SEED=configs/users.yaml

# Cross-repo topology pre-analysis limits (docs/cross-repo-topology-discovery.md)
# SUPERNOVA_TOPOLOGY_MAX_REPOS=8
# SUPERNOVA_TOPOLOGY_MAX_CONCURRENT=1
# SUPERNOVA_TOPOLOGY_TIMEOUT_SECONDS=900
# SUPERNOVA_TOPOLOGY_MAX_TURNS=30
# SUPERNOVA_TOPOLOGY_CACHE_TTL_SECONDS=86400
# SUPERNOVA_TOPOLOGY_MAX_STORED_ANALYSES=100
